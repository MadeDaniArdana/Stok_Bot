generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  name              String
  divisionName      String?
  requestTemplateId String?
  requestTemplate   DistributionTemplate? @relation(fields: [requestTemplateId], references: [id], onDelete: Restrict)
  email             String             @unique
  passwordHash      String?
  sessionVersion    Int                @default(0)
  sessions          WebSession[]
  role              String             @default("USER") // ADMIN, DIVISI (pengaju barang), USER
  isActive          Boolean            @default(true)
  movements         StockMovement[]
  installationTasks InstallationTask[] @relation("TaskCreator")
  distributions     Distribution[]
  itemRequests      ItemRequest[]
  telegram          TelegramUser?
  notifications     Notification[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([requestTemplateId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  // Jenis stok: LISTRIK (Peralatan Listrik), LOGISTIK, ATK. Barang mengikuti jenis kategorinya.
  stockGroup  String    @default("ATK")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([stockGroup])
}

model Product {
  id                String                     @id @default(uuid())
  sku               String                     @unique
  name              String
  description       String?
  categoryId        String?
  category          Category?                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit              String // satuan dasar penyimpanan stok (mis. pcs, gram)
  // Satuan kemasan opsional: 1 packUnit = packSize satuan dasar (mis. 1 krat = 24 pcs, 1 kg = 1000 gram).
  packUnit          String?
  packSize          Int?
  currentStock      Int                        @default(0)
  minimumStock      Int                        @default(0)
  isActive          Boolean                    @default(true)
  movements         StockMovement[]
  installationTasks InstallationTask[]
  distributionItems DistributionItem[]
  requestItems      ItemRequestItem[]
  templateItems     DistributionTemplateItem[]
  notifications     Notification[]
  monthlySnapshots  StockMonthlySnapshot[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([isActive, name])
  @@index([categoryId])
}

model StockMovement {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  actorUserId      String?
  actor            User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  // Nama pelaku disalin saat akunnya dihapus agar riwayat tetap menunjukkan siapa pelakunya.
  actorName        String?
  type             String // IN, OUT, ADJUSTMENT, REVERSAL
  quantity         Int
  stockBefore      Int
  stockAfter       Int
  source           String // WEB, TELEGRAM, SYSTEM
  referenceId      String?
  notes            String?
  telegramUpdateId String?  @unique
  createdAt        DateTime @default(now())

  @@index([productId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  // Mencari transaksi milik dokumen distribusi/tugas dan transaksi pembalik.
  @@index([referenceId])
}

/// Sisa stok akhir bulan per barang (cache laporan), hanya untuk bulan yang sudah lewat (WIB).
/// Dibuat otomatis saat laporan dibuka; aman dihapus kapan saja (akan dihitung ulang dari riwayat).
model StockMonthlySnapshot {
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Bulan WIB, format YYYY-MM.
  month        String
  closingStock Int
  createdAt    DateTime @default(now())

  @@id([productId, month])
  @@index([month])
}

model TelegramUser {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  telegramUserId String   @unique
  telegramChatId String
  username       String?
  isActive       Boolean  @default(true)
  linkedAt       DateTime @default(now())
}

// Catatan error dari web, Telegram, AI, upload foto, dan browser untuk ditelusuri admin.
model ErrorLog {
  id        String   @id @default(uuid())
  source    String // WEB, TELEGRAM, AI, UPLOAD, NOTIFICATION, BROWSER
  level     String   @default("ERROR") // ERROR, WARNING
  message   String
  location  String? // route API, fungsi, atau halaman tempat error terjadi
  stack     String?
  context   String? // JSON: request, ID Telegram, isi pesan, dsb.
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
  @@index([source, createdAt])
}

// ID Telegram yang diizinkan sebagai admin bot (ditambah dari web), selain TELEGRAM_ADMIN_IDS di env.
model TelegramAdmin {
  id             String   @id @default(uuid())
  telegramUserId String   @unique
  label          String?
  createdAt      DateTime @default(now())
}

model TelegramUpdate {
  id               String    @id @default(uuid())
  telegramUpdateId String    @unique
  chatId           String?
  telegramUserId   String?
  payload          String?
  status           String    @default("RECEIVED") // RECEIVED, PROCESSING, PROCESSED, FAILED, IGNORED
  errorMessage     String?
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  @@index([receivedAt])
  @@index([status])
}

model TelegramConversation {
  telegramUserId String   @id
  chatId         String
  state          String
  data           String   @default("{}")
  updatedAt      DateTime @updatedAt
}

model InstallationTask {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Null jika akun admin pembuatnya dihapus; riwayat tugas tetap tersimpan.
  creatorUserId String?
  creator       User?     @relation("TaskCreator", fields: [creatorUserId], references: [id], onDelete: SetNull)
  creatorName   String? // nama pembuat, disalin saat akunnya dihapus
  quantity      Int
  assigneeName  String
  location      String
  notes         String?
  status        String    @default("PENDING") // PENDING, COMPLETED
  tokenHash     String    @unique
  proofFileName String?
  proofMimeType String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([creatorUserId, status, createdAt])
  @@index([productId, status])
}

model Notification {
  id              String   @id @default(uuid())
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  recipientUserId String?
  recipient       User?    @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            String // LOW_STOCK, OUT_OF_STOCK, SYSTEM
  message         String
  isRead          Boolean  @default(false)
  dedupeKey       String?  @unique
  createdAt       DateTime @default(now())

  @@index([recipientUserId, isRead, createdAt])
  @@index([createdAt])
  @@index([isRead])
}

// Form Distribusi Barang (pengiriman barang ke unit/ruang). Setiap item mengurangi stok
// lewat StockMovement OUT dengan referenceId = id distribusi.
model Distribution {
  id              String              @id @default(uuid())
  number          String              @unique // contoh: ATK-202611-001
  stockGroup      String // LISTRIK, LOGISTIK, ATK
  recipientUnit   String // "Kepada" (unit/bagian) atau "Ruang" untuk peralatan listrik
  orderNumber     String? // No. Nota Pesanan
  distributedAt   DateTime // Tanggal pesanan / distribusi
  storageLocation String? // Tempat penyimpanan
  receiverName    String? // Penerima
  handoverName    String // Yang menyerahkan / petugas
  officerPhone    String? // No. WhatsApp petugas (opsional, format 62xxx), untuk kirim link foto
  notes           String?
  status          String              @default("COMPLETED") // COMPLETED, CANCELLED
  cancelReason    String?
  cancelledAt     DateTime?
  // Foto bukti lewat link (khusus Peralatan Listrik), mirip tugas pemasangan di Telegram.
  proofTokenHash  String?
  proofFileName   String?
  proofMimeType   String?
  proofUploadedAt DateTime?
  creatorUserId   String?
  creator         User?               @relation(fields: [creatorUserId], references: [id], onDelete: SetNull)
  creatorName     String? // nama pencatat, disalin saat akunnya dihapus
  items           DistributionItem[]
  // Foto bukti per lokasi pemasangan (Peralatan Listrik dengan lebih dari satu ruang).
  proofs          DistributionProof[]
  createdAt       DateTime            @default(now())

  @@index([stockGroup, distributedAt])
  @@index([status])
  // Token acak 256-bit, cukup index (tanpa unique) untuk pencarian link foto.
  @@index([proofTokenHash])
}

model DistributionItem {
  id             String       @id @default(uuid())
  distributionId String
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  unit           String // satuan saat distribusi dibuat
  // Lokasi pemasangan item ini (Peralatan Listrik); kosong = sama dengan recipientUnit dokumen.
  location       String?
  movementId     String?      @unique

  @@index([distributionId])
  @@index([productId])
}

// Satu foto bukti untuk tiap lokasi pemasangan dalam satu dokumen distribusi.
model DistributionProof {
  id             String       @id @default(uuid())
  distributionId String
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  location       String
  fileName       String
  mimeType       String
  uploadedAt     DateTime     @default(now())

  @@unique([distributionId, location])
}

// Paket distribusi: template tabel barang per unit (mis. BAAK FSIP, LPPM, Prodi FTIK)
// yang dimuat ke Form Distribusi lalu bisa diubah sebelum disimpan.
model DistributionTemplate {
  id              String                     @id @default(uuid())
  stockGroup      String // LISTRIK, LOGISTIK, ATK
  name            String // nama paket, mis. "BAAK FSIP"
  recipientUnit   String // isian "Kepada"
  storageLocation String?
  receiverName    String?
  items           DistributionTemplateItem[]
  divisionUsers   User[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([stockGroup, name])
}

model DistributionTemplateItem {
  id         String               @id @default(uuid())
  templateId String
  template   DistributionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  sortOrder  Int                  @default(0)

  @@unique([templateId, productId])
  @@index([productId])
}

// Pengajuan barang dari akun divisi. Disetujui admin -> otomatis menjadi dokumen Distribusi (stok berkurang).
model ItemRequest {
  id                 String            @id @default(uuid())
  number             String            @unique // contoh: PJ-202611-001
  stockGroup         String // ATK atau LOGISTIK
  requesterId        String?
  requester          User?             @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  requesterName      String // disalin agar tetap ada bila akun dihapus
  divisionName       String // "Kepada" (unit tujuan) yang ditetapkan admin
  receiverName       String? // nama yang mengajukan / penerima (penanda tangan)
  divisionHeadName   String? // nama Ka. Divisi pada blok "Mengetahui," di form pengajuan
  notes              String?
  requesterSignature String? // tanda tangan digital pengaju (PNG data URL)
  adminSignature     String? // tanda tangan digital admin saat review (opsional)
  approvedDate       DateTime? // tanggal ACC yang ditentukan admin
  storageLocation    String? // tempat penyimpanan di formulir
  status             String            @default("PENDING") // PENDING, PROCESSING, APPROVED, REJECTED
  rejectReason       String?
  decidedAt          DateTime?
  decidedByName      String?
  distributionId     String?
  distributionNumber String?
  items              ItemRequestItem[]
  createdAt          DateTime          @default(now())

  @@index([status, createdAt])
  @@index([requesterId])
}

model ItemRequestItem {
  id        String      @id @default(uuid())
  requestId String
  request   ItemRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Barang master (kosong bila pengaju mengetik barang di luar daftar; admin memetakan saat review).
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  customName       String? // nama barang yang diketik pengaju
  customUnit       String?
  specification    String? // spesifikasi barang pada form pengajuan divisi
  itemNotes        String? // keterangan (Ket.) per baris barang
  quantity         Int // jumlah pengajuan (Kebutuhan*)
  approvedQuantity Int? // jumlah ACC / Pesanan dari admin
  noStock          Boolean  @default(false) // ACC tapi tidak mengurangi stok

  @@index([requestId])
}

model LoginAttemptBucket {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model WebSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}
