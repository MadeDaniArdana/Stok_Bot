generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(uuid())
  name              String
  email             String          @unique
  passwordHash      String?
  role              String          @default("USER") // ADMIN, USER
  isActive          Boolean         @default(true)
  movements         StockMovement[]
  installationTasks InstallationTask[] @relation("TaskCreator")
  telegram          TelegramUser?
  notifications     Notification[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                String          @id @default(uuid())
  sku               String          @unique
  name              String
  description       String?
  categoryId        String?
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit              String
  currentStock      Int             @default(0)
  minimumStock      Int             @default(0)
  isActive          Boolean         @default(true)
  movements         StockMovement[]
  installationTasks InstallationTask[]
  notifications     Notification[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([isActive, name])
  @@index([categoryId])
}

model StockMovement {
  id               String         @id @default(uuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  actorUserId      String?
  actor            User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  type             String         // IN, OUT, ADJUSTMENT, REVERSAL
  quantity         Int
  stockBefore      Int
  stockAfter       Int
  source           String         // WEB, TELEGRAM, SYSTEM
  referenceId      String?
  notes            String?
  telegramUpdateId String?        @unique
  createdAt        DateTime       @default(now())

  @@index([productId, createdAt])
  @@index([actorUserId, createdAt])
}

model TelegramUser {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  telegramUserId  String   @unique
  telegramChatId  String
  username        String?
  isActive        Boolean  @default(true)
  linkedAt        DateTime @default(now())
}

// Catatan error dari web, Telegram, AI, upload foto, dan browser untuk ditelusuri admin.
model ErrorLog {
  id        String   @id @default(uuid())
  source    String   // WEB, TELEGRAM, AI, UPLOAD, NOTIFICATION, BROWSER
  level     String   @default("ERROR") // ERROR, WARNING
  message   String
  location  String?  // route API, fungsi, atau halaman tempat error terjadi
  stack     String?
  context   String?  // JSON: request, ID Telegram, isi pesan, dsb.
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
  @@index([source, createdAt])
}

// ID Telegram yang diizinkan sebagai admin bot (ditambah dari web), selain TELEGRAM_ADMIN_IDS di env.
model TelegramAdmin {
  id             String   @id @default(uuid())
  telegramUserId String   @unique
  label          String?
  createdAt      DateTime @default(now())
}

model TelegramUpdate {
  id               String    @id @default(uuid())
  telegramUpdateId String    @unique
  chatId           String?
  telegramUserId   String?
  payload          String?
  status           String    @default("RECEIVED") // RECEIVED, PROCESSING, PROCESSED, FAILED, IGNORED
  errorMessage     String?
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
}

model TelegramConversation {
  telegramUserId String   @id
  chatId         String
  state          String
  data           String   @default("{}")
  updatedAt      DateTime @updatedAt
}


model InstallationTask {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  creatorUserId String
  creator       User      @relation("TaskCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  quantity      Int
  assigneeName  String
  location      String
  notes         String?
  status        String    @default("PENDING") // PENDING, COMPLETED
  tokenHash     String    @unique
  proofFileName String?
  proofMimeType String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([creatorUserId, status, createdAt])
  @@index([productId, status])
}

model Notification {
  id              String   @id @default(uuid())
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  recipientUserId String?
  recipient       User?    @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            String   // LOW_STOCK, OUT_OF_STOCK, SYSTEM
  message         String
  isRead          Boolean  @default(false)
  dedupeKey       String?  @unique
  createdAt       DateTime @default(now())

  @@index([recipientUserId, isRead, createdAt])
}
