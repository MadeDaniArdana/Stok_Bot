{
  "name": "stockflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "test:reports": "node --test tests/installation-reports.test.cjs",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:seed-distribusi": "node --env-file=.env prisma/seed-distribusi.js",
    "db:seed-pdf": "node --env-file=.env prisma/seed-from-pdf.js",
    "db:seed-templates": "node --env-file=.env prisma/seed-listrik-and-templates.js",
    "admin:reset": "node --env-file=.env prisma/reset-admin.js",
    "db:snapshot-reset": "node --env-file=.env prisma/reset-stock-snapshot.js",
    "db:satuan-ukuran": "node --env-file=.env prisma/update-satuan-ukuran.js",
    "db:backup": "node --env-file=.env prisma/backup.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "@vercel/blob": "2.4.0",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.453.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.1.0",
    "recharts": "^2.13.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
