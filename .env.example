# PostgreSQL (Docker lokal / server kampus, atau Neon/Supabase)
# Contoh Docker lokal/server kampus (sesuai docker-compose.yml):
DATABASE_URL="postgresql://stockflow:GANTI_PASSWORD_KUAT@127.0.0.1:5432/stockflow?schema=public"
# Konfigurasi container PostgreSQL di docker-compose.yml
POSTGRES_USER="stockflow"
POSTGRES_PASSWORD="GANTI_PASSWORD_KUAT"
POSTGRES_DB="stockflow"
POSTGRES_PORT="5432"
APP_PORT="3000"
# Aktifkan hanya jika reverse proxy menimpa X-Real-IP dan port aplikasi tidak bisa diakses langsung.
TRUST_PROXY_IP="0"
# Kunci penanda tangan sesi login, minimal 32 karakter acak
AUTH_SECRET="replace-with-strong-random-secret"

# Akun admin yang dibuat oleh `npm run db:seed` (kata sandi tidak disimpan di repo)
ADMIN_EMAIL="nama@teknokrat.ac.id"
ADMIN_NAME="Nama Admin"
ADMIN_PASSWORD=""
# URL publik aplikasi, dipakai untuk membuat link bukti foto (contoh: https://stokbot.vercel.app)
APP_URL="http://localhost:3000"

TELEGRAM_BOT_TOKEN="replace-with-bot-token"
TELEGRAM_WEBHOOK_SECRET="replace-with-random-secret"
TELEGRAM_BOT_USERNAME="your_bot_username"
# ID Telegram admin yang boleh membuat tugas, pisahkan dengan koma
TELEGRAM_ADMIN_IDS=""

# Token Blob store privat untuk unggahan baru. Wajib di Vercel.
# Di luar Vercel, tanpa token foto disimpan di TASK_PROOF_DIRECTORY atau uploads/task-proofs.
PROOF_PRIVATE_BLOB_TOKEN=""
# Token Blob store publik lama, untuk menghapus file lama saja.
BLOB_READ_WRITE_TOKEN=""
# TASK_PROOF_DIRECTORY=""

# Chatbot AI. AI_PROVIDER: "openai" (API berformat OpenAI, misalnya server Qwen lokal) atau "gemini"
AI_PROVIDER="openai"
OPENAI_BASE_URL="https://server-ai-anda/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="Qwen/Qwen2.5-VL-7B-Instruct-AWQ"

# API key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Opsional, default gemini-2.5-flash
# GEMINI_MODEL=""
